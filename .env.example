# Code Intel — environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI — gpt-4.1 answers and gpt-4o-mini query expansion.
OPENAI_API_KEY=sk-your-openai-key-here

# Voyage AI — voyage-code-3 embeddings and rerank-2.5-lite re-ranking.
VOYAGE_API_KEY=pa-your-voyage-key-here

# ── Optional ──────────────────────────────────────────────────────────────────
# Absolute path to the directory holding the repos you want to index.
# Default: ~/Desktop/Repos
# CODE_INTEL_REPOS_DIR=/absolute/path/to/your/repos

# Set to 1 to allow account creation through POST /auth/register in the web UI.
# Default: off — register with `python cli.py register` instead. The very first
# account can always be created, so a fresh install can bootstrap itself.
# ALLOW_WEB_REGISTRATION=1
